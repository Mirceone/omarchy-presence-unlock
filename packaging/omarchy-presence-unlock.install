post_install() {
  echo "Run 'omarchy-presence-unlock setup' as your desktop user inside your Omarchy session to apply per-user integration."
  echo "Pacman cannot do this: it runs as root without your home, D-Bus, or compositor session."
}

post_upgrade() {
  echo "The Omarchy shell caches the installed plugin; rescanPlugins does not reload it."
  echo "Run 'omarchy-presence-unlock setup' from inside your Omarchy session; it detects the change and restarts the shell."
}

pre_remove() {
  echo "Removing the application package. Per-user settings are not package-owned."
  echo "The application's uninstall command cleans the current user's integration before package removal; other users' settings are left untouched."
}

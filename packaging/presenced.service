[Unit]
Description=BLE device presence authorization for Omarchy
After=bluetooth.target
ConditionPathExists=%E/omarchy-presence-unlock/config.toml

[Service]
ExecStart=/usr/bin/presenced
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=omarchy-presence-unlock
RuntimeDirectoryMode=0700
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK
UMask=0077

[Install]
WantedBy=default.target
